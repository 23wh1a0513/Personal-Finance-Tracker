# Copy this file to .env and fill in your values
# Use your MongoDB Atlas connection string (URI) here.
# Example:
# DATABASE_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

DATABASE_URI=

# A random secret used for signing JWT tokens.
# Keep this secret safe and do not commit it to source control.
JWT_SECRET=

# Optional: Set to change the backend port (default: 5000)
PORT=5000
